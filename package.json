{
  "name": "cmdmentor",
  "version": "0.1.0",
  "description": "Cross-platform offline-first command reference and learning assistant",
  "type": "module",
  "bin": {
    "cmdmentor": "./dist/bin/cmdmentor.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "knowledge"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/bin/cmdmentor.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:kb": "vitest run tests/unit/loader.test.ts tests/unit/kb-invariants.test.ts tests/unit/doctor.test.ts",
    "typecheck": "tsc --noEmit",
    "test:safety": "vitest run tests/unit/safety.test.ts tests/unit/execution-gate.test.ts tests/unit/placeholders.test.ts",
    "kb:doctor": "node dist/bin/cmdmentor.js kb doctor --bundled-only",
    "verify": "npm run typecheck && npm run build && npm test && npm run kb:doctor"
  },
  "keywords": [
    "cli",
    "tui",
    "command-reference",
    "cheatsheet",
    "offline",
    "powershell",
    "bash",
    "developer-tools"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "clipboardy": "^4.0.0",
    "commander": "^12.1.0",
    "fuse.js": "^7.0.2",
    "ink": "^5.2.1",
    "picocolors": "^1.1.1",
    "react": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@vitest/coverage-v8": "^2.1.9",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
