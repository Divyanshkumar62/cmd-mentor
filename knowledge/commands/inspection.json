  {
    "id": "inspection.tail.posix",
    "name": "tail",
    "title": "Output the last part of files",
    "description": "Prints the last 10 lines of each file to standard output. With -f, follows append changes in real-time.",
    "commandTemplate": "tail [options] <file>",
    "platforms": [
      "linux",
      "macos",
      "windows"
    ],
    "shells": [
      "bash",
      "zsh",
      "git-bash"
    ],
    "category": [
      "inspection",
      "logs"
    ],
    "tags": [
      "tail",
      "log",
      "follow",
      "last lines",
      "inspect"
    ],
    "aliases": [
      "view last lines of log",
      "tail -f log",
      "follow log file",
      "show last 50 log lines"
    ],
    "flags": [
      {
        "name": "-f",
        "shorthand": "--follow",
        "description": "Output appended data as the file grows."
      },
      {
        "name": "-n",
        "shorthand": "--lines",
        "description": "Output the last N lines, instead of the default last 10."
      }
    ],
    "examples": [
      {
        "command": "tail -n 50 app.log",
        "explanation": "Outputs the last 50 lines of app.log."
      },
      {
        "command": "tail -f /var/log/syslog",
        "explanation": "Monitors and streams new log lines added to syslog in real time."
      }
    ],
